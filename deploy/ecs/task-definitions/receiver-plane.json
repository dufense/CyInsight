{
  "family": "ccc-receiver-plane",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ccc-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ccc-receiver-task-role",
  "containerDefinitions": [
    {
      "name": "receiver-plane",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/ccc-receiver-plane:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "api"
        },
        {
          "containerPort": 514,
          "hostPort": 514,
          "protocol": "udp",
          "name": "syslog-udp"
        },
        {
          "containerPort": 1514,
          "hostPort": 1514,
          "protocol": "tcp",
          "name": "syslog-tcp"
        },
        {
          "containerPort": 6514,
          "hostPort": 6514,
          "protocol": "tcp",
          "name": "syslog-tls"
        }
      ],
      "environment": [
        { "name": "NODE_ENV",            "value": "production" },
        { "name": "PORT",                "value": "5000" },
        { "name": "PLANE",               "value": "receiver" },
        { "name": "CLUSTER_WORKERS_MAX", "value": "1" },
        { "name": "WORKER_MAX_RSS_MB",   "value": "700" },
        { "name": "PARQUET_DATA_DIR",    "value": "/app/data/events" },
        { "name": "APP_REPORTS_DIR",     "value": "/app/data/reports" },
        { "name": "APP_UPLOADS_DIR",     "value": "/app/data/uploads" },
        { "name": "DB_POOL_MAX",         "value": "5" }
      ],
      "secrets": [
        {
          "name": "KAFKA_BROKERS",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/shared/kafka-brokers"
        },
        {
          "name": "MANAGEMENT_PLANE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/shared/management-plane-url"
        },
        {
          "name": "DATA_PLANE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/shared/data-plane-url"
        },
        {
          "name": "AI_PROVIDER",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/ai/provider"
        },
        {
          "name": "AI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/ai/api-key"
        },
        {
          "name": "AI_MODEL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/ai/model"
        },
        {
          "name": "AI_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ccc/ai/base-url"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:5000/healthz || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 45
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ccc-receiver-plane",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ],
      "stopTimeout": 30
    }
  ],
  "tags": [
    { "key": "Project",   "value": "CyberCommandCenter" },
    { "key": "Plane",     "value": "receiver" },
    { "key": "ManagedBy", "value": "ecs" }
  ]
}
