##############################################################################
# Cyber Command Center — ECS Fargate Environment Reference
#
# These values are stored in AWS Secrets Manager, not in a .env file.
# Use deploy/ecs/scripts/setup-secrets.sh to populate them.
# This file documents what each secret path must contain.
##############################################################################

# ── Required Tooling ──────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-south-1           # Primary AWS region (management + receiver plane)
IMAGE_TAG=v1.0.0                # Docker image tag to deploy
ENVIRONMENT=production          # production | staging | development

# ── VPC & Networking (deployment script inputs) ───────────────────────────────
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
PUBLIC_SUBNETS=subnet-aaa,subnet-bbb         # For ALB / NLB (2 AZs minimum)
PRIVATE_SUBNETS=subnet-ccc,subnet-ddd        # For ECS Fargate tasks
CERTIFICATE_ARN=arn:aws:acm:ap-south-1:123456789012:certificate/xxxxx-xxxx

# ── Secrets Manager Paths & Expected Values ───────────────────────────────────
# Format: SECRET_PATH=example_value

# Shared
#   ccc/shared/kafka-brokers            b-1.ccc.xxx.kafka.ap-south-1.amazonaws.com:9092,b-2...
#   ccc/shared/management-plane-url     http://ccc-management-alb.internal.example.com
#   ccc/shared/data-plane-url           http://ccc-dp-in-west-1-alb.internal.example.com

# AI Provider
#   ccc/ai/provider   openai | anthropic | azure | vertex | ollama | huggingface | custom
#                     grok   | deepseek  | kimi  | zai
#   ccc/ai/api-key    sk-...  (API key for the selected provider)
#   ccc/ai/model      gpt-4o | claude-3-5-sonnet-20241022 | grok-2-latest | deepseek-chat | moonshot-v1-32k | glm-4-flash | ...
#   ccc/ai/base-url   Leave empty for openai/anthropic/grok/deepseek/kimi/zai defaults.
#                     Required for ollama (e.g. http://ollama-service:11434/v1), azure, custom.

# Management Plane
#   ccc/management/database-url         postgresql://secureops:pass@ccc-management-production.xxx.rds.amazonaws.com:5432/secureops_management?sslmode=require
#   ccc/management/session-secret       <random 64+ character string>
#   ccc/management/redis-url            redis://:password@elasticache-host:6379/0
#   ccc/management/superadmin-password  Admin@YourSecurePassword!
#
# Database SSL (RDS requires TLS — these vars fine-tune the SSL behavior)
#   DB_SSL=true                  (default in production; sslmode=require in URL is sufficient)
#   DB_SSL_CA=/app/certs/global-bundle.pem    (optional — for cert verification; download from AWS)
#   PARQUET_DATA_DIR=/app/data/events   (EFS-backed Parquet event store for DuckDB warm queries.
#                                         Must point to the EFS mount path — NOT /tmp — so files
#                                         survive Fargate task restarts and are shared across replicas.
#                                         Default: /app/data/events  [set in task-definition JSON])
#   DB_POOL_MAX=5                (CRITICAL for ECS: limits connections per worker process.
#                                 Formula: DB_POOL_MAX × CLUSTER_WORKERS_MAX × ECS_TASK_COUNT ≤ RDS_MAX_CONNECTIONS
#                                 Example: 5 × 2 workers × 4 tasks = 40 connections (safe for db.t3.medium ~123 max)
#                                 Default 20 is fine for single-instance dev but WILL exhaust RDS in production.
#                                 Set to 5 for management-plane and data-plane. Receiver plane has no direct DB.
#                                 For RDS Proxy users: set to 20 (proxy pools efficiently across tasks.)
#   DB_STATEMENT_TIMEOUT_MS=30000
#   DB_QUERY_TIMEOUT_MS=30000

# Storage
#   ccc/storage/provider                s3               (s3|azure|gcs|minio)
#   ccc/storage/s3-bucket               ccc-reports-production-123456789012
#   ccc/storage/s3-region               ap-south-1

# Data Plane — per region (repeat for each of the 5 regions)
# Regions: in-west-1 | us-east-1 | ke-east-1 | sa-central-1 | bh-east-1
#
#   ccc/data-plane/in-west-1/database-url        postgresql://user:pass@rds-host:5432/secureops_events?sslmode=require
#   ccc/data-plane/in-west-1/opensearch-url      https://search-ccc-in-west-1.ap-south-1.es.amazonaws.com
#   ccc/data-plane/in-west-1/opensearch-username admin
#   ccc/data-plane/in-west-1/opensearch-password <opensearch master password>
#   ccc/data-plane/in-west-1/plane-region        in-west-1
#   ccc/data-plane/in-west-1/s3-bucket           ccc-events-in-west-1-production-123456789012
#
#   (Repeat for us-east-1, ke-east-1, sa-central-1, bh-east-1)

# ── AWS Managed Services Required ─────────────────────────────────────────────
#
# Management Plane:
#   - Amazon RDS PostgreSQL 16           (management DB)
#   - Amazon ElastiCache Redis 7         (session store + cache)
#   - Amazon MSK (Kafka 3.x, KRaft mode) (shared event bus)
#   - Amazon EFS                         (reports/uploads persistent storage)
#   - Amazon S3                          (report exports)
#   - AWS Secrets Manager                (all secrets)
#   - Amazon CloudWatch                  (logs + metrics)
#
# Data Plane (per region):
#   - Amazon RDS PostgreSQL 16 + TimescaleDB extension
#     (or Aurora PostgreSQL compatible with Babelfish extension)
#   - Amazon OpenSearch Service          (event search + SIEM queries)
#   - Amazon MSK (shared with management)
#   - Amazon EFS                         (parquet/data files)
#   - Amazon S3 (region-specific bucket) (event lake storage)
#
# Receiver Plane:
#   - Amazon MSK (shared)                (event streaming output)
#   - No persistent storage required

# ── TimescaleDB Note ──────────────────────────────────────────────────────────
# RDS PostgreSQL does not support the TimescaleDB extension natively.
# For the Data Plane database, use one of:
#   Option A: Timescale Cloud (managed TimescaleDB) — https://www.timescale.com/cloud
#   Option B: Self-managed TimescaleDB on EC2 (within the same VPC)
#   Option C: Aurora PostgreSQL (if event queries can be adapted to standard PG)

# ── MSK Configuration ─────────────────────────────────────────────────────────
# Recommended MSK cluster config:
#   Kafka version:  3.6.x (KRaft mode)
#   Instance type:  kafka.m5.large (production) or kafka.t3.small (dev/staging)
#   Brokers:        3 (across 3 AZs)
#   Storage:        500 GB per broker (gp3, encrypted)
#   Topics:         Auto-create enabled
#   Partitions:     6 per topic
#   Replication:    3
#   Retention:      168h (7 days)

# ── Fargate Platform Version ──────────────────────────────────────────────────
# Use Fargate platform 1.4.0+ for:
#   - EFS volume support
#   - UDP port mappings (receiver plane)
#   - Enhanced container insights
