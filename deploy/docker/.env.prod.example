###############################################################################
# Cyber Command Center — Production Environment Variables
#
# Copy to .env.prod and fill in all values before running:
#   docker compose -f deploy/docker/docker-compose.prod.yml \
#     --env-file .env.prod up -d
#
# SECURITY: Never commit .env.prod to source control.
###############################################################################

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production

# Number of CPU worker processes for vertical scaling.
# Set to the number of vCPUs on the VM (e.g. 8, 16, 32).
# Defaults to number of CPUs detected if unset.
CLUSTER_WORKERS=4

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=secureops
DB_PASSWORD=CHANGE_ME_strong_db_password

# Full DSN — auto-constructed from above but override here if using external PG
MANAGEMENT_DATABASE_URL=postgresql://secureops:CHANGE_ME_strong_db_password@management-db:5432/secureops_management

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
SESSION_SECRET=CHANGE_ME_generate_64_char_random_string_here

# ─── Admin ────────────────────────────────────────────────────────────────────
SUPERADMIN_DEFAULT_PASSWORD=CHANGE_ME_Admin@123

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama | azure | vertex | huggingface | custom
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=sk-CHANGE_ME
AI_BASE_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_MAXMEMORY=2gb
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=21474836480
KAFKA_NUM_PARTITIONS=16
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BUCKET=ccc-events

# ─── ClickHouse (single source of truth for security events) ─────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=<set strong value in production>

# ─── Ports ────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
RECEIVER_PORT=5001

# ─── Images (override to pull from private registry) ──────────────────────────
MANAGEMENT_IMAGE=ccc/management:latest
RECEIVER_IMAGE=ccc/receiver:latest

# ─── Data Plane ───────────────────────────────────────────────────────────────
DATA_PLANE_REGION=onprem-1
DATA_PLANE_REGION_NAME=On-Premises (Production)

# ─── Pipeline Tuning ──────────────────────────────────────────────────────────
POLLING_CONCURRENCY=10
MAX_EVENTS_PER_CYCLE=20000
CONSUMER_CONCURRENCY=20
DETECTION_BATCH_SIZE=200
STORAGE_BATCH_SIZE=1000
BACKPRESSURE_LATENCY_MS=5000
IOC_CACHE_TTL_MS=3600000
CORRELATION_WINDOW_MS=300000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# ─── Retention ────────────────────────────────────────────────────────────────
HOT_RETENTION_DAYS=90
WARM_RETENTION_DAYS=365
COLD_RETENTION_DAYS=1095
