###############################################################################
# SecureOps Platform — Environment Configuration
#
# Copy this file to .env and configure for your deployment target.
# Usage:
#   docker-compose -f docker-compose.onprem.yml --env-file deploy/docker/.env up -d
#   docker-compose -f docker-compose.microservices.yml --env-file deploy/docker/.env up -d
###############################################################################

#------------------------------------------------------------------------------
# General
#------------------------------------------------------------------------------
NODE_ENV=production

#------------------------------------------------------------------------------
# Database — Management Plane (PostgreSQL)
#------------------------------------------------------------------------------
DB_USER=secureops
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MANAGEMENT_DATABASE_URL=postgresql://secureops:CHANGE_ME_STRONG_PASSWORD@management-db:5432/secureops_management
MGMT_DB_PORT=5432

#------------------------------------------------------------------------------
# Database — Data Plane (TimescaleDB)
#------------------------------------------------------------------------------
DATAPLANE_DATABASE_URL=postgresql://secureops:CHANGE_ME_STRONG_PASSWORD@data-plane-db:5432/secureops_events
DP_DB_PORT=5433

# For AWS RDS:
# MANAGEMENT_DATABASE_URL=postgresql://secureops:PASSWORD@mydb.xxxx.us-east-1.rds.amazonaws.com:5432/secureops_management
# DATAPLANE_DATABASE_URL=postgresql://secureops:PASSWORD@mydb-events.xxxx.us-east-1.rds.amazonaws.com:5432/secureops_events

# For Azure Database for PostgreSQL:
# MANAGEMENT_DATABASE_URL=postgresql://secureops@myserver:PASSWORD@myserver.postgres.database.azure.com:5432/secureops_management?sslmode=require
# DATAPLANE_DATABASE_URL=postgresql://secureops@myserver:PASSWORD@myserver-events.postgres.database.azure.com:5432/secureops_events?sslmode=require

# For GCP Cloud SQL:
# MANAGEMENT_DATABASE_URL=postgresql://secureops:PASSWORD@/secureops_management?host=/cloudsql/project:region:instance
# DATAPLANE_DATABASE_URL=postgresql://secureops:PASSWORD@/secureops_events?host=/cloudsql/project:region:instance-events

#------------------------------------------------------------------------------
# Session & Auth
#------------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING
SUPERADMIN_DEFAULT_PASSWORD=Admin@123

#------------------------------------------------------------------------------
# AI Provider
#------------------------------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

#------------------------------------------------------------------------------
# Kafka
#------------------------------------------------------------------------------
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_NUM_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=10737418240

# For AWS MSK:
# KAFKA_BROKERS=b-1.mymsk.xxxx.kafka.us-east-1.amazonaws.com:9092,b-2.mymsk.xxxx.kafka.us-east-1.amazonaws.com:9092

# For Azure Event Hubs (Kafka protocol):
# KAFKA_BROKERS=mynamespace.servicebus.windows.net:9093

# For GCP Managed Kafka / Confluent:
# KAFKA_BROKERS=bootstrap.myproject.us-central1.managedkafka.myproject.cloud.goog:9092

#------------------------------------------------------------------------------
# Redis
#------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379

# For AWS ElastiCache:
# REDIS_URL=redis://my-cluster.xxxx.use1.cache.amazonaws.com:6379

# For Azure Cache for Redis:
# REDIS_URL=rediss://:ACCESS_KEY@myredis.redis.cache.windows.net:6380

#------------------------------------------------------------------------------
# Object Storage
#------------------------------------------------------------------------------
CLOUD_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BUCKET=secureops-events-local

# For AWS S3:
# CLOUD_STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=my-secureops-bucket
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# For Azure Blob Storage:
# CLOUD_STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT=mystorageaccount
# AZURE_STORAGE_KEY=...
# AZURE_STORAGE_CONTAINER=secureops

# For GCP Cloud Storage:
# CLOUD_STORAGE_PROVIDER=gcs
# GCS_BUCKET=my-secureops-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

#------------------------------------------------------------------------------
# ClickHouse (single source of truth for security events)
#------------------------------------------------------------------------------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=<set in production>

#------------------------------------------------------------------------------
# Data Plane Region
#------------------------------------------------------------------------------
DATA_PLANE_REGION=local-1
DATA_PLANE_REGION_NAME=On-Premises (Local)
MANAGEMENT_PLANE_URL=http://nginx:80

#------------------------------------------------------------------------------
# Service Ports
#------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
RECEIVER_PORT=5001
DATA_PLANE_PORT=5002
COLLECTOR_PORT=5010
NORMALIZER_PORT=5011
DETECTION_PORT=5012
ENRICHMENT_PORT=5013
STORAGE_PORT=5014

#------------------------------------------------------------------------------
# Service Tuning
#------------------------------------------------------------------------------
POLLING_CONCURRENCY=5
MAX_EVENTS_PER_CYCLE=10000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=300000
CONSUMER_CONCURRENCY=10
DETECTION_BATCH_SIZE=100
STORAGE_BATCH_SIZE=500
BACKPRESSURE_LATENCY_MS=5000
IOC_CACHE_TTL_MS=3600000
CORRELATION_WINDOW_MS=300000

#------------------------------------------------------------------------------
# Data Retention
#------------------------------------------------------------------------------
HOT_RETENTION_DAYS=90
WARM_RETENTION_DAYS=365
COLD_RETENTION_DAYS=1095
