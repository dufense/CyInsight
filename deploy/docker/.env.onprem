###############################################################################
# SecureOps Platform — On-Premises Deployment Defaults
#
# Usage:
#   docker-compose -f docker-compose.onprem.yml --env-file deploy/docker/.env.onprem up -d
###############################################################################

NODE_ENV=production

DB_USER=secureops
DB_PASSWORD=secureops_onprem_password
MANAGEMENT_DATABASE_URL=postgresql://secureops:secureops_onprem_password@management-db:5432/secureops_management
DATAPLANE_DATABASE_URL=postgresql://secureops:secureops_onprem_password@data-plane-db:5432/secureops_events
MGMT_DB_PORT=5432
DP_DB_PORT=5433

SESSION_SECRET=onprem-change-me-to-random-64-char-string
SUPERADMIN_DEFAULT_PASSWORD=Admin@123

AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_NUM_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=10737418240

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379

CLOUD_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BUCKET=secureops-events-local

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default

DATA_PLANE_REGION=local-1
DATA_PLANE_REGION_NAME=On-Premises (Local)
MANAGEMENT_PLANE_URL=http://nginx:80

HTTP_PORT=80
HTTPS_PORT=443
RECEIVER_PORT=5001
DATA_PLANE_PORT=5002
COLLECTOR_PORT=5010
NORMALIZER_PORT=5011
DETECTION_PORT=5012
ENRICHMENT_PORT=5013
STORAGE_PORT=5014

POLLING_CONCURRENCY=5
MAX_EVENTS_PER_CYCLE=10000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=300000
CONSUMER_CONCURRENCY=10
DETECTION_BATCH_SIZE=100
STORAGE_BATCH_SIZE=500
BACKPRESSURE_LATENCY_MS=5000
IOC_CACHE_TTL_MS=3600000
CORRELATION_WINDOW_MS=300000

HOT_RETENTION_DAYS=90
WARM_RETENTION_DAYS=365
COLD_RETENTION_DAYS=1095
