# =============================================================================
# SecureOps MSSP Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before starting the application.
# For Docker Compose: docker compose --env-file .env up
# =============================================================================

# --- Database ---
# PostgreSQL connection string (required)
# For RDS: postgresql://user:pass@your-rds-host.rds.amazonaws.com:5432/dbname?sslmode=require
DATABASE_URL=postgresql://secureops:your_password@localhost:5432/secureops

# --- Database SSL (for RDS / Aurora / any TLS-required PostgreSQL) ---
# DB_SSL=true              → enable SSL (with rejectUnauthorized=false — suitable for RDS)
# DB_SSL=false             → disable SSL (local dev default)
# DB_SSL_CA=/path/to/ca   → path to custom CA bundle (RDS global-bundle.pem from AWS)
# If DATABASE_URL contains sslmode=require, SSL is enabled automatically.
# In production (NODE_ENV=production), SSL defaults to enabled if not explicitly set.
DB_SSL=false

# DB_POOL_MAX=20            → max connections in the pool (default: 20 for RDS-compatible sizing)
# DB_STATEMENT_TIMEOUT_MS   → PostgreSQL statement timeout in ms (default: 30000)
# DB_QUERY_TIMEOUT_MS       → Client-side query timeout in ms (default: 30000)
# DB_POOL_MAX=20

# --- Session ---
# Secret key for session encryption (required, use a strong random string)
SESSION_SECRET=your-strong-random-session-secret-here

# --- OpenAI / AI Features ---
# OpenAI API key for AI-powered features (optional - app works without it)
OPENAI_API_KEY=sk-your-openai-api-key

# Custom OpenAI-compatible API base URL (optional)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Application ---
# Server port (default: 5000)
PORT=5000

# Node environment (development or production)
NODE_ENV=production

# --- Docker Compose specific ---
# Database password for Docker Compose PostgreSQL container
DB_PASSWORD=secureops_dev_password

# Default superadmin password (change after first login)
SUPERADMIN_DEFAULT_PASSWORD=Admin@123

# =============================================================================
# Cloud Deployment Configuration
# =============================================================================

# --- Application Base URL ---
# Used for generating external links (e.g. incident notification emails).
# Set to the public HTTPS URL of your deployment.
# APP_BASE_URL=https://app.example.com

# --- File Storage Paths ---
# Override where reports and uploads are stored on disk.
# Defaults to /tmp/secureops/{reports,uploads} for container / read-only-FS environments.
# On bare-metal or VM deployments with persistent storage, set to a durable path.
# APP_REPORTS_DIR=/data/secureops/reports
# APP_UPLOADS_DIR=/data/secureops/uploads

# --- Cluster Workers ---
# CLUSTER_WORKERS=auto       → one worker per visible CPU (default)
# CLUSTER_WORKERS=4          → pin to exactly 4 workers
# CLUSTER_WORKERS_MAX=4      → cap worker count (important for ECS Fargate — host CPU
#                              count is visible but only task vCPUs are allocated)
# CLUSTER_WORKERS=auto
# CLUSTER_WORKERS_MAX=4

# --- Cloud Object Storage ---
# Provider: s3 | azure | gcs | minio  (default: minio for local dev)
# CLOUD_STORAGE_PROVIDER=s3
# CLOUD_STORAGE_BUCKET=secureops-data
# CLOUD_STORAGE_REGION=us-east-1

# AWS S3 / MinIO
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT=          # leave empty for AWS; set for MinIO e.g. http://minio:9000
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# Azure Blob Storage
# AZURE_STORAGE_ACCOUNT_NAME=...
# AZURE_STORAGE_ACCOUNT_KEY=...
# AZURE_STORAGE_CONNECTION_STRING=   # alternative to account name/key

# Google Cloud Storage
# GCP_PROJECT_ID=my-gcp-project
# GCP_KEY_FILE_PATH=/run/secrets/gcs-key.json   # omit to use Workload Identity / ADC

# --- AI Provider ---
# Vendor-neutral AI abstraction. Defaults to OpenAI if OPENAI_API_KEY is set.
# AI_PROVIDER=openai        # openai | anthropic | ollama | azure | vertex | huggingface | custom
# AI_MODEL=gpt-4o           # model name (provider-specific)
# AI_API_KEY=               # provider API key (or use OPENAI_API_KEY for openai)
# AI_BASE_URL=              # custom base URL (for azure, vertex, ollama, or OpenAI-compat)
#
# Anthropic
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-sonnet-20241022
#
# Azure OpenAI
# AI_PROVIDER=azure
# AI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# AI_API_KEY=<azure-api-key>
# AI_MODEL=gpt-4o
#
# Google Vertex AI
# AI_PROVIDER=vertex
# AI_BASE_URL=https://<region>-aiplatform.googleapis.com/v1/projects/<project>/locations/<region>
# AI_API_KEY=               # omit to use ADC (Workload Identity)
# AI_MODEL=gemini-1.5-pro
#
# Ollama (self-hosted)
# AI_PROVIDER=ollama
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=llama3.2

# --- Data Lake (Warm Tier Parquet) ---
# Directory where DuckDB reads warm-tier Parquet event files.
# PARQUET_DATA_DIR=/tmp/secureops/events

# --- ECS Fargate (AWS) ---
# Set these in your ECS task definition / Secrets Manager instead of .env
# DB_SSL=true
# DB_SSL_CA=/app/certs/global-bundle.pem
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_QUERY_TIMEOUT_MS=30000
