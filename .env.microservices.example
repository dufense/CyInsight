# SecureOps Microservices Environment Configuration
# Copy this to .env and fill in your values

# Database
DB_PASSWORD=secureops_dev_password

# Authentication
SESSION_SECRET=change-me-to-a-strong-random-string
SUPERADMIN_DEFAULT_PASSWORD=Admin@123

# AI / OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Kafka (override if external Kafka cluster)
# KAFKA_BROKERS=kafka:9092

# Redis (override if external Redis)
# REDIS_URL=redis://redis:6379

# Check Point HEC (for collector service)
CHECKPOINT_CLIENT_ID=
CHECKPOINT_SECRET_KEY=

# CrowdStrike (for collector service)
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=

# Azure AD (for collector service)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Storage & Retention
HOT_RETENTION_DAYS=90
WARM_RETENTION_DAYS=365
COLD_RETENTION_DAYS=1095

# Scaling
POLLING_CONCURRENCY=5
MAX_EVENTS_PER_CYCLE=10000
CONSUMER_CONCURRENCY=10
BATCH_SIZE=500

# Region
REGION=eu-west
