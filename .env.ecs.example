##############################################################################
# .env.ecs.example — Cyber Command Center: ECS Fargate Environment Reference
#
# This file documents every environment variable consumed by the application.
# Copy it and fill in real values; then push secrets to AWS Secrets Manager
# using deploy/ecs/scripts/setup-secrets.sh instead of shipping a .env file
# into the container.
#
# Variable categories:
#   [REQUIRED]  — App will crash or mis-behave without this value.
#   [OPTIONAL]  — Sensible default exists; override only if needed.
#   [SECRETS]   — Must be stored in AWS Secrets Manager (never in the image).
#   [PLAIN ENV] — Non-secret; set directly in the ECS task definition JSON.
#
# ECS Fargate deployment:
#   • PLAIN ENV vars → "environment" array in task-definition JSON files
#                      (deploy/ecs/task-definitions/*.json)
#   • SECRETS       → "secrets" array (valueFrom = Secrets Manager ARN)
#                      Provision via: ./deploy/ecs/scripts/setup-secrets.sh
#
# Local development (Docker Compose / bare Node):
#   Copy this file to .env, fill in values, and run:
#     docker compose up   OR   NODE_ENV=development node start-prod.js
##############################################################################

# ── Runtime / Node.js ─────────────────────────────────────────────────────────
# [PLAIN ENV / REQUIRED]
NODE_ENV=production
PORT=5000

# Logical plane identifier.  Drives feature flags and startup mode.
# Accepted values: management | data | receiver
PLANE=management

# ── Cluster / Concurrency ─────────────────────────────────────────────────────
# [PLAIN ENV / OPTIONAL]
# Cap the number of Node.js cluster workers per container.
# Rule of thumb: (vCPU allocated to the Fargate task) ÷ 1 = safe worker count.
# Keep at 1 for Replit / autoscale targets that scale horizontally.
CLUSTER_WORKERS_MAX=2
# Override only if you need an exact worker count regardless of CPU count.
# CLUSTER_WORKERS=4

# [PLAIN ENV / OPTIONAL] — Maximum worker RSS in MB before start-prod.js triggers
# a graceful restart of that worker (OOM prevention).
# Fargate 2 GB task: 800 MB is a safe ceiling with 2 workers.
# Fargate 4 GB task: increase to 1600 MB.
WORKER_MAX_RSS_MB=800

# ── Database — Primary ────────────────────────────────────────────────────────
# [SECRETS / REQUIRED]
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# [PLAIN ENV / OPTIONAL] — Maximum pg pool connections per task.
# With multiple ECS replicas: divide the RDS max_connections by replica count.
# db.t3.micro ≈ 87 max; db.t3.medium ≈ 340 max.
DB_POOL_MAX=5

# [PLAIN ENV / OPTIONAL] — Force SSL for RDS / Aurora connections.
# DB_SSL=true               → TLS with rejectUnauthorized=false (self-signed / RDS)
# DB_SSL=false              → disable TLS (local dev only)
# DB_SSL_CA=/path/to/ca.pem → TLS with CA bundle verification (recommended prod)
DB_SSL=true
# DB_SSL_CA=/etc/ssl/certs/rds-ca-bundle.pem

# [PLAIN ENV / OPTIONAL] — PostgreSQL PGSSLMODE (passed to libpq).
# verify-ca = match server cert against CA; require = encrypt but skip hostname check.
PGSSLMODE=verify-ca

# [PLAIN ENV / OPTIONAL] — Node.js TLS: make the runtime trust the same CA bundle
# so pg connections succeed when the server cert is issued by RDS CA.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-ca-bundle.pem

# [PLAIN ENV / OPTIONAL] — Per-statement and client-side socket timeouts (ms).
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=15000

# ── Database — Read Replica ───────────────────────────────────────────────────
# [SECRETS / OPTIONAL]
# When set, heavy analytics queries (SOC metrics, MTTR/MTTD) are routed to this
# pool.  Falls back to primary pool transparently when not configured.
# READ_REPLICA_URL=postgresql://reader:password@replica.hostname:5432/dbname?sslmode=require

# ── Session / Auth ────────────────────────────────────────────────────────────
# [SECRETS / REQUIRED]
# 64-character random string.  Generate: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME_64_CHAR_RANDOM_HEX

# [PLAIN ENV / OPTIONAL] — Set to "true" to send session cookies with Secure flag.
# Must be true in production (HTTPS only).  Set false for local HTTP dev.
SECURE_COOKIES=true

# ── Superadmin Bootstrap ──────────────────────────────────────────────────────
# [SECRETS / OPTIONAL]
# Initial password for the built-in platform_admin account (hashed on first boot).
# Change this immediately after the first login.
SUPERADMIN_DEFAULT_PASSWORD=REPLACE_ME

# ── Persistent Data Directories (EFS on Fargate) ─────────────────────────────
# [PLAIN ENV / REQUIRED on Fargate — override defaults]
# These MUST point to subdirectories of the EFS mount (/app/data) so data
# survives Fargate task restarts and is shared across replicas.
# The Dockerfile pre-creates all three dirs; EFS provides durability.
#
# Default fallback (non-EFS environments like local dev / CI):
#   /tmp/secureops/{reports,uploads,events}
#
APP_REPORTS_DIR=/app/data/reports
APP_UPLOADS_DIR=/app/data/uploads
PARQUET_DATA_DIR=/app/data/events

# ── AI Provider ───────────────────────────────────────────────────────────────
# [SECRETS / REQUIRED] — Select exactly one provider.
#
# Supported values for AI_PROVIDER:
#   openai      → api.openai.com          (set AI_MODEL=gpt-4o or similar)
#   anthropic   → api.anthropic.com       (set AI_MODEL=claude-3-5-sonnet-20241022)
#   azure       → Azure OpenAI endpoint   (set AI_BASE_URL=https://YOUR.openai.azure.com)
#   vertex      → Google Vertex AI        (set AI_BASE_URL=https://REGION-aiplatform.googleapis.com/...)
#   ollama      → Local Ollama            (set AI_BASE_URL=http://localhost:11434)
#   huggingface → HuggingFace Inference   (set AI_BASE_URL=https://api-inference.huggingface.co/models/...)
#   bedrock     → AWS Bedrock             (uses task IAM role; no API key needed)
#   custom      → Any OpenAI-compatible   (set AI_BASE_URL to your endpoint)
#
# New providers (OpenAI-compatible API):
#   grok        → xAI Grok               (AI_BASE_URL=https://api.x.ai/v1)
#                                         Models: grok-2-latest, grok-2-vision-latest
#   deepseek    → DeepSeek               (AI_BASE_URL=https://api.deepseek.com/v1)
#                                         Models: deepseek-chat, deepseek-reasoner
#   kimi        → Moonshot Kimi          (AI_BASE_URL=https://api.moonshot.cn/v1)
#                                         Models: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
#   zai         → Zhipu AI (GLM)        (AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4)
#                                         Models: glm-4-flash, glm-4, glm-4-long
#
AI_PROVIDER=openai
AI_API_KEY=sk-REPLACE_ME
AI_MODEL=gpt-4o
# AI_BASE_URL=                           # Leave empty for openai/anthropic; required for others

# [PLAIN ENV / OPTIONAL] — AWS region for Bedrock foundation model calls.
# Automatically set to the Fargate task region via CloudFormation; override if needed.
# AI_REGION=ap-south-1

# ── Redis / Cache ─────────────────────────────────────────────────────────────
# [SECRETS / OPTIONAL]
# When set, enables shared in-memory caching across ECS replicas.
# Falls back to in-process LRU cache when not configured (fine for single-task).
# REDIS_URL=redis://:password@your-elasticache-host:6379

# ── Apache Kafka / MSK ────────────────────────────────────────────────────────
# [SECRETS / OPTIONAL]
# Comma-separated list of broker host:port pairs.
# Required for multi-plane deployments (event streaming between planes).
# KAFKA_BROKERS=b-1.your-cluster.kafka.ap-south-1.amazonaws.com:9092,b-2...

# [PLAIN ENV / OPTIONAL] — Kafka producer publish timeout (ms).
# KAFKA_PUBLISH_TIMEOUT_MS=5000

# ── ClickHouse ───────────────────────────────────────────────────────────────
# [SECRETS / OPTIONAL] — OLAP analytics engine for the events console and SOC metrics.
# CLICKHOUSE_URL=http://ccc-ch-alb.internal:8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=REPLACE_ME
# CLICKHOUSE_DATABASE=ccc

# ── Cloud Object Storage ──────────────────────────────────────────────────────
# [SECRETS / OPTIONAL] — Required for AI report PDF archival and data lake writes.
#
# Supported providers: s3 | azure | gcs | minio
CLOUD_STORAGE_PROVIDER=s3
AWS_S3_BUCKET=ccc-reports-ACCOUNT_ID
AWS_S3_REGION=ap-south-1
# For Azure Blob:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_CONTAINER_NAME=ccc-reports
# For Google Cloud Storage:
# GCS_BUCKET_NAME=ccc-reports
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# For MinIO (on-prem):
# MINIO_ENDPOINT=http://minio.internal:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=REPLACE_ME
# MINIO_BUCKET=ccc-reports

# ── Multi-Plane Federation ────────────────────────────────────────────────────
# [PLAIN ENV / OPTIONAL] — Set on data-plane and receiver-plane containers.
# MANAGEMENT_PLANE_URL=http://ccc-management-alb.internal
# DATA_PLANE_URL=http://ccc-dp-primary.internal

# [PLAIN ENV / OPTIONAL] — JSON map of all data-plane ALB URLs (management plane).
# Populated after data-plane stacks are deployed and ALB DNS names are known.
# DATA_PLANE_ENDPOINTS={"india":"http://REPLACE","bahrain":"http://REPLACE","kenya":"http://REPLACE"}
# MANAGEMENT_PLANE_REGION=ap-south-1

# ── Seeding ───────────────────────────────────────────────────────────────────
# [PLAIN ENV / OPTIONAL]
# Set to "true" only on the very first boot to seed initial tenants/users.
# Reset to "false" (or remove) after the first successful seed.
ENABLE_SEEDING=false

# ── Service Mesh (internal microservice endpoints) ───────────────────────────
# [PLAIN ENV / OPTIONAL] — Internal service URLs for specialized plane workers.
# Only needed if those services run as separate containers.
# ENRICHMENT_SERVICE_URL=http://enrichment-service:8001
# NORMALIZER_SERVICE_URL=http://normalizer-service:8002
# DETECTION_SERVICE_URL=http://detection-service:8003
# COLLECTOR_SERVICE_URL=http://collector-service:8004
# STORAGE_SERVICE_URL=http://storage-service:8005
# CLICKHOUSE_URL=http://clickhouse.internal:8123

# ── Email (optional notifications) ───────────────────────────────────────────
# [SECRETS / OPTIONAL]
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIAIOSFODNN7EXAMPLE
# SMTP_PASS=REPLACE_ME
# SMTP_FROM=noreply@your-domain.com

# ── SSO / SAML (enterprise tenant SSO) ───────────────────────────────────────
# [SECRETS / OPTIONAL] — Configured per tenant via Admin Portal, not globally.
# SAML_CERT=-----BEGIN CERTIFICATE-----\n...
# OIDC_CLIENT_ID=client-id
# OIDC_CLIENT_SECRET=REPLACE_ME
# OIDC_ISSUER=https://your-idp.example.com

# ── MFA ───────────────────────────────────────────────────────────────────────
# [PLAIN ENV / OPTIONAL]
# MFA_ISSUER=CyberCommandCenter

##############################################################################
# ECS-Specific Notes
# ──────────────────
# 1. All [SECRETS] vars above MUST be stored in AWS Secrets Manager, never
#    baked into the Docker image or passed as plaintext in the task definition.
#    Run: ./deploy/ecs/scripts/setup-secrets.sh
#
# 2. All [PLAIN ENV] vars should be set in the "environment" array of the
#    appropriate task-definition JSON:
#      deploy/ecs/task-definitions/management-plane.json
#      deploy/ecs/task-definitions/data-plane.json
#      deploy/ecs/task-definitions/receiver-plane.json
#
# 3. EFS mount: the Fargate task mounts EFS at /app/data.
#    APP_REPORTS_DIR, APP_UPLOADS_DIR, and PARQUET_DATA_DIR must point
#    into /app/data/* to survive task restarts.  Do NOT use /tmp paths.
#
# 4. DB_POOL_MAX should be tuned per replica count:
#    RDS max_connections ÷ (number of Fargate replicas × workers per task)
#    Example: db.t3.medium (340 max) ÷ 4 replicas ÷ 2 workers = 42 per pool
#    Keep headroom for migrations and the session store (subtract ~10).
#
# 5. AI provider selection:
#    - openai / anthropic: No AI_BASE_URL needed; defaults to official endpoints.
#    - bedrock: No AI_API_KEY needed; uses ECS task IAM role (EnableBedrock=true
#      in CloudFormation to attach the Bedrock policy).
#    - grok / deepseek / kimi / zai: Set AI_BASE_URL to the endpoint listed
#      in the AI Provider section above.  All use OpenAI-compatible REST API.
#    - custom: Set AI_BASE_URL to any OpenAI-compatible endpoint.
##############################################################################
